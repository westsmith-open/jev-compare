{
  "id": "recipe_dietary",
  "title": "Recipe dietary tagging",
  "annual_volume": 200000,
  "description": "Tag recipes on a cooking site from their ingredient lists: the most inclusive diet they suit, whether they contain gluten or nuts, and how spicy they are. The house rules in each question settle the usual grey areas. All recipes are illustrative.",
  "questions": [
    {
      "id": "diet",
      "type": "choice",
      "instructions": "Which is the most restrictive diet this recipe suits as written? Treat all cheese as vegetarian. Honey, eggs, butter and milk are vegetarian but not vegan. Anchovies, fish sauce, shrimp paste and Worcestershire sauce count as fish. Gelatin counts as meat.",
      "criteria": {
        "vegan": "No animal products at all.",
        "vegetarian": "No meat or fish, but may include dairy, eggs or honey.",
        "pescatarian": "Contains fish or seafood but no other meat.",
        "omnivore": "Contains meat or poultry, or gelatin."
      }
    },
    {
      "id": "contains_gluten",
      "type": "noul",
      "instructions": "The recipe contains gluten. Wheat, barley, rye, ordinary soy sauce and oats contain gluten unless the ingredient says gluten-free. Tamari, rice and corn do not.",
      "criteria": {
        "true": "At least one ingredient contains gluten under these rules.",
        "false": "No ingredient contains gluten under these rules."
      }
    },
    {
      "id": "contains_nuts",
      "type": "noul",
      "instructions": "The recipe contains nuts. Peanuts, tree nuts, pine nuts and nut milks count as nuts. Coconut and sesame (including tahini) do not.",
      "criteria": {
        "true": "At least one ingredient is or contains nuts under these rules.",
        "false": "No ingredient is or contains nuts under these rules."
      }
    },
    {
      "id": "spice",
      "type": "score",
      "instructions": "How spicy is the recipe?",
      "levels": [
        {"key": "mild", "text": "Mild: no chilli or hot ingredients."},
        {"key": "medium", "text": "Medium: some heat, such as one or two mild chillies, chilli flakes or a spoon of hot sauce."},
        {"key": "hot", "text": "Hot: several hot chillies, Scotch bonnets, bird's eye chillies or a lot of cayenne."}
      ]
    }
  ],
