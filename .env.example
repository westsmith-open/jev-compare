# Copy to .env and fill in. A model whose key is missing runs in simulated mode
# (clearly labelled in the UI) so the demo still works end to end.

# Easiest: one OpenRouter key runs both models (Jev via the Decisions API,
# Gemini via chat completions). A direct key below takes precedence.
OPENROUTER_API_KEY=
# Optional, OpenRouter path only: "minimal" | "low" | "medium" | "high"
# GEMINI_REASONING_EFFORT=low

# TypeSafe Jev (System One API). Early access is behind a waitlist.
TYPESAFE_API_KEY=
# Defaults to https://api.typesafe.ai/v1/systemone. Point at a proxy
# (e.g. a LiteLLM pass-through) if that is how you have access.
# JEV_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-1.13

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Optional: "minimal" | "low" | "medium" | "high". Thinking tokens bill as output.
# GEMINI_THINKING_LEVEL=low
